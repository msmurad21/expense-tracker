# Copy this file to .env.local and fill it in. .env.local is gitignored.
#
# These credentials are ONLY used by the command-line scripts (npm run sync).
# The desktop app stores your App Password in the OS keychain instead, via
# Electron safeStorage — it never reads this file.

# The Gmail address to read.
GMAIL_USER=you@gmail.com

# A 16-character Gmail App Password, spaces removed.
#   1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:     https://myaccount.google.com/apppasswords
#
# NOTE: App Passwords do not work for Google Workspace accounts (a custom
# domain rather than @gmail.com) — Google disabled them in 2025. Those accounts
# need the Gmail API option instead.
GMAIL_APP_PASSWORD=
