{
  "name": "expense-tracker",
  "productName": "Expense Tracker",
  "version": "0.1.0",
  "description": "Local-first desktop app that turns your bank alert emails and subscription receipts into a clear picture of what you are actually paying for every month.",
  "license": "MIT",
  "author": "Shah Murad",
  "type": "module",
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "doctor": "tsx scripts/doctor.ts",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "sync": "tsx scripts/sync.ts",
    "analyze": "tsx scripts/analyze.ts",
    "seed-demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-fuses": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@electron/fuses": "^1.8.0",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
